{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsageBatch",
  "type": "object",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientInfo"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsageEvent"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "client",
    "events"
  ],
  "$defs": {
    "ClientInfo": {
      "description": "Lets the backend detect clients running with a different policy or configuration than it published.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "policy_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "config_hash": {
          "description": "Hex SHA-256 of the effective (merged) configuration.",
          "type": "string"
        },
        "failure_modes": {
          "description": "The failure modes the client is running with, every condition resolved.",
          "anyOf": [
            {
              "$ref": "#/$defs/FailureModes"
            },
            {
              "type": "null"
            }
          ]
        },
        "fail_open_count": {
          "description": "Requests passed through because a failure mode was `open`, counted since the client started.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "policy_version",
        "config_hash"
      ]
    },
    "FailureModes": {
      "description": "Behaviour per failure condition. Each override falls back to `default`; local config may only choose `Closed`.",
      "type": "object",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unscannable": {
          "description": "The request body cannot be read or scanned (unknown encoding, base64 media).",
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scan_error": {
          "description": "The scanner timed out or failed internally.",
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_expired": {
          "description": "The snapshot has expired and no fresh one can be fetched.",
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_down": {
          "description": "The local service is down. Applied when routing is written (PAC fallback, managed settings), not at runtime.",
          "anyOf": [
            {
              "$ref": "#/$defs/FailMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "FailMode": {
      "description": "What to do when the client cannot make a normal decision.",
      "oneOf": [
        {
          "description": "Let the traffic through and record that it was passed because of a failure.",
          "type": "string",
          "const": "open"
        },
        {
          "description": "Block the traffic.",
          "type": "string",
          "const": "closed"
        }
      ]
    },
    "UsageEvent": {
      "description": "Metadata about one proxied request. Never carries prompt content.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "blocked": {
          "type": "boolean"
        },
        "findings": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp",
        "provider",
        "model",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "status",
        "blocked",
        "findings"
      ]
    }
  }
}
