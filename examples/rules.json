{
  "schema": 1,
  "version": 1,
  "issued_at": 1767225600,
  "expires_at": 1798761600,
  "pii": [
    {
      "id": "card",
      "label": "Credit card number",
      "pattern": "\\b(?:\\d[ -]?){13,19}\\b",
      "validator": "luhn",
      "action": "block",
      "enabled": true
    },
    {
      "id": "ssn",
      "label": "US Social Security number",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "validator": "ssn",
      "action": "block",
      "enabled": true
    },
    {
      "id": "iban",
      "label": "IBAN",
      "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b",
      "validator": "iban",
      "action": "block",
      "enabled": true
    },
    {
      "id": "email",
      "label": "Email address",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "validator": null,
      "action": "log",
      "enabled": true
    },
    {
      "id": "phone",
      "label": "Phone number",
      "pattern": "\\+\\d{1,3}[ -]?\\(?\\d{2,4}\\)?[ -]?\\d{3,4}[ -]?\\d{3,4}\\b",
      "validator": null,
      "action": "log",
      "enabled": true
    },
    {
      "id": "aws_key",
      "label": "AWS access key",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "api_key",
      "label": "API key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{20,}",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "github_token",
      "label": "GitHub token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "slack_token",
      "label": "Slack token",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "google_key",
      "label": "Google API key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "private_key",
      "label": "Private key",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "validator": null,
      "action": "block",
      "enabled": true
    },
    {
      "id": "jwt",
      "label": "JSON web token",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]+",
      "validator": null,
      "action": "block",
      "enabled": true
    }
  ],
