{
  "covers": [
    "openrouter-key",
    "openrouter-model"
  ],
  "request": {
    "host": "openrouter.ai",
    "path": "/api/v1/chat/completions",
    "headers": {
      "authorization": "Bearer sk-or-v1-FAKEFAKEFAKE",
      "content-type": "application/json"
    },
    "body": {
      "model": "openai/gpt-4.1-nano",
      "messages": [
        {
          "role": "user",
          "content": "Say ok."
        }
      ],
      "max_tokens": 16
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "id": "gen-FAKE",
      "model": "openai/gpt-4.1-nano",
      "provider": "OpenAI",
      "choices": [
        {
          "message": {
            "role": "assistant",
            "content": "ok"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 9,
        "completion_tokens": 2,
        "total_tokens": 11,
        "cost": 1e-06
      }
    }
  },
  "expect": {
    "billing": "api",
    "billing_signal": "openrouter-key",
    "model": "openai/gpt-4.1-nano",
    "model_signal": "openrouter-model",
    "served_by": null,
    "input_tokens": 9,
    "output_tokens": 2,
    "cache_read_tokens": 0,
    "cache_write_tokens": 0
  }
}
