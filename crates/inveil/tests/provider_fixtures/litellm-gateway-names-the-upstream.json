{
  "covers": [
    "litellm-upstream"
  ],
  "request": {
    "host": "gateway.internal.example",
    "path": "/v1/responses",
    "headers": {
      "authorization": "Bearer sk-litellm-FAKE"
    },
    "body": {
      "model": "my-alias",
      "input": "Say ok.",
      "max_output_tokens": 16
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "x-litellm-model-api-base": "https://api.openai.com/v1",
      "x-litellm-model-id": "deployment-FAKE"
    },
    "body": {
      "id": "resp_FAKE",
      "object": "response",
      "status": "completed",
      "model": "gpt-4.1-nano-2025-04-14",
      "output": [
        {
          "type": "message",
          "content": [
            {
              "type": "output_text",
              "text": "ok"
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 50,
        "input_tokens_details": {
          "cached_tokens": 40
        },
        "output_tokens": 3,
        "total_tokens": 53
      }
    }
  },
  "expect": {
    "billing": "unknown",
    "billing_signal": null,
    "model": "my-alias",
    "model_signal": null,
    "served_by": "api.openai.com",
    "input_tokens": 50,
    "output_tokens": 3,
    "cache_read_tokens": 40,
    "cache_write_tokens": 0
  }
}
